{
  "name": "tev1-router",
  "version": "0.1.0",
  "description": "Picks Haiku, Sonnet or Opus for each prompt with tev1, a small local decision model in Ollama: no proxy, no Claude tokens spent on routing.",
  "author": { "name": "idan2025" },
  "homepage": "https://github.com/idan2025/tev1-router",
  "license": "MIT",
  "userConfig": {
    "ollamaUrl": {
      "type": "string",
      "title": "Ollama URL",
      "description": "Where Ollama serves tev1.",
      "default": "http://localhost:11434"
    },
    "tev1Model": {
      "type": "string",
      "title": "Decision model",
      "description": "The Ollama decision model to ask (tev1 or tev1:0.8b).",
      "default": "tev1"
    },
    "haikuModel": { "type": "string", "title": "Haiku model", "description": "Model id for quick tasks.", "default": "claude-haiku-5-5" },
    "sonnetModel": { "type": "string", "title": "Sonnet model", "description": "Model id for normal tasks.", "default": "claude-sonnet-5-5" },
    "opusModel": { "type": "string", "title": "Opus model", "description": "Model id for hard tasks.", "default": "claude-opus-5-5" }
  }
}
